APP_NAME=Autonomous Research Agent
APP_ENV=development
# Defaults to backend/data/research_agent.db. Keep the existing path when upgrading.
# DATABASE_URL=sqlite:///./data/research_agent.db
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
RESEARCH_CONTACT_EMAIL=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_HOURS=12
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_ATTEMPTS=2
SEARCH_BUDGET_SECONDS=90
# Keys stay server-side. OpenAlex supports basic anonymous search; a key raises limits.
# Retry-After cooldowns are process-local; a distributed worker needs shared throttling.
AUTH_MAX_ATTEMPTS=20
AUTH_WINDOW_SECONDS=300
MAX_ACTIVE_RUNS_PER_USER=3
# Production requires APP_ENV=production, HTTPS origins, and SESSION_COOKIE_SECURE=true.
# For genuinely cross-site hosting use SameSite=none plus HTTPS, or a same-site API proxy.

# Maximum simultaneous provider searches per process.
PROVIDER_CONCURRENCY=3

# Optional server-only LLM integration. Disabled preserves deterministic research.
# Copy this file to backend/.env; process environment variables take precedence.
# Fill the two blank values below, then set LLM_ENABLED=true and restart the backend.
# Never use VITE_ variables for credentials. Do not commit backend/.env.
# Verify from the repository root: python backend/scripts/verify_llm.py
# Exit 0 means a fresh structured request succeeded; 2 means configuration is not ready.
# A model must be accessible to YOUR API project and support Responses structured output.
# Blank values are placeholders, not usable credentials.
LLM_ENABLED=false
LLM_PROVIDER=openai
# Set an API model available to your account that supports Responses structured outputs.
LLM_MODEL=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=25
LLM_MAX_ATTEMPTS=2
LLM_CONCURRENCY=2
LLM_MAX_INPUT_TOKENS=16000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_RUN_TOKEN_BUDGET=72000
LLM_CACHE_SECONDS=300
LLM_MAX_RETRY_DELAY_SECONDS=5

# Opt-in licensed Europe PMC full-text bodies; at most two papers per run.
RESEARCH_FULLTEXT_ENABLED=false
